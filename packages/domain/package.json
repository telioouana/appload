        "format": "prettier --write \"**/*.{ts,tsx}\"",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@trpc/server": "^11.18.0",
        "@workspace/auth": "workspace:*",
        "@workspace/comms": "workspace:*",
