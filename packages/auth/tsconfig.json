{
    "extends": "@workspace/typescript-config/base.json",
    "compilerOptions": {
        "rootDir": "src",
        "noEmit": true,
        "declaration": false,
        "declarationMap": false,
        "paths": {
            "@/*": [
                "./src/*"
            ]
        },
        "types": [
            "node"
        ]
    },
    "include": [
        "."
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}