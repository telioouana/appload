# Every variable the partner portal reads. Copy to .env for local development;
# set the same names in the Vercel project for production. See RELEASE.md
# for the full deploy checklist.
#
# NEXT_PUBLIC_* values are inlined at build time — changing them in Vercel
# requires a REBUILD, not just a redeploy.

# --- Database (Neon Postgres) ------------------------------------------------
# The same database as the admin; migrations live in packages/db
DATABASE_URL=

# --- Better Auth -------------------------------------------------------------
# MUST be the same secret as the admin: one auth instance, one cookie signature
BETTER_AUTH_SECRET=
# This app's public origin (dev: http://localhost:3001)
BETTER_AUTH_URL=

# --- App ---------------------------------------------------------------------
# Public origin of the admin app, used in the ops emails this app sends
NEXT_PUBLIC_APP_URL=
# Public origin of this portal; the admin's invitation emails link to it
NEXT_PUBLIC_PORTAL_URL=
# Where claim requests that could not be auto-approved are announced
OPS_NOTIFICATION_EMAIL=
# Address behind the "talk to Appload" prompts (subscription plans are set by
# staff in the admin, so a plan change is a conversation). Falls back to
# comercial@apploadafrica.com when unset
NEXT_PUBLIC_CONTACT_EMAIL=

# --- Email (Resend) ----------------------------------------------------------
# Unset in development = sends are simulated (logged, reported ok).
# In production a missing key FAILS sends loudly — verification and password
# reset emails depend on it.
RESEND_API_KEY=
EMAIL_FROM=

# --- Google Sheets sync (service account) -----------------------------------
# Read at import by packages/auth: "service-account" keeps the Google
# sign-in scopes basic while the spreadsheets scope is pending verification.
# The portal has no Google sign-in, but the shared auth module reads it.
NEXT_PUBLIC_GOOGLE_SHEETS_AUTH_MODE=service-account

# --- EdgeStore (file storage) ------------------------------------------------
# Order documents (POD, evidence) uploaded by partners
EDGE_STORE_ACCESS_KEY=
EDGE_STORE_SECRET_KEY=
EDGE_STORE_PROJECT_ID=
EDGE_STORE_PUBLIC_HOST=

# --- WhatsApp / SMS (Infobip) ------------------------------------------------
# Trip tracking pings. Unset in development = sends are simulated
INFOBIP_BASE_URL=
INFOBIP_API_KEY=
INFOBIP_SENDER=
INFOBIP_TRACKING_TEMPLATE=
INFOBIP_TRACKING_TEMPLATE_LANGUAGE=
INFOBIP_WEBHOOK_SECRET=

# --- Cron (Upstash QStash) ---------------------------------------------------
# Signing keys from the Upstash console — without BOTH, every QStash
# delivery is rejected and no cron runs. Register schedules once with:
#   node apps/app/scripts/qstash-schedules.mjs --apply
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
# Only needed by the operator running the schedules script, not the app
QSTASH_TOKEN=
# Manual/emergency cron trigger: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# --- Google Maps -------------------------------------------------------------
# Server key (Routes API, geocoding)
GOOGLE_MAPS_API_KEY=
# Browser key for the Maps JS SDK; add this portal's origin to its referrers
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# --- Compliance --------------------------------------------------------------
# "warn" (default) logs KYC violations without blocking; "block" enforces
KYC_ENFORCEMENT=
