# Every variable the public site reads. Copy to .env for local development;
# set the same names in the Vercel website project for production. See
# RELEASE.md for the deploy checklist.
#
# NEXT_PUBLIC_* values are inlined at build time — changing them in Vercel
# requires a REBUILD, not just a redeploy.

# --- Database (Neon Postgres) ------------------------------------------------
# Read-only usage: the homepage metrics dashboard aggregates orders/fleet
# hourly (ISR). Same platform database as the admin app.
DATABASE_URL=

# --- Site / SEO --------------------------------------------------------------
# Canonical origin for metadataBase, canonicals, hreflang, sitemap, robots
# and OG URLs. Unset, the code falls back to https://appload.co.mz.
NEXT_PUBLIC_SITE_URL=

# --- Google ------------------------------------------------------------------
# Search Console verification meta tag. Only needed for the HTML-tag
# verification method — a Domain property verified via DNS TXT needs none.
#GOOGLE_SITE_VERIFICATION=

# GA4 measurement id (G-XXXXXXXXXX). Analytics stays OFF until this is set.
#NEXT_PUBLIC_GA_ID=
