# Every variable the admin app reads. Copy to .env for local development;
# set the same names in the Vercel project for production. See RELEASE.md
# for the full deploy checklist.
#
# NEXT_PUBLIC_* values are inlined at build time — changing them in Vercel
# requires a REBUILD, not just a redeploy.

# --- Database (Neon Postgres) ------------------------------------------------
# Apply schema with: pnpm --filter @workspace/db db:migrate (never db:push in prod)
DATABASE_URL=

# --- Better Auth -------------------------------------------------------------
# Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# The app's public origin. URL1 is required (also the base-URL fallback);
# 2-4 are optional extra trusted origins (e.g. preview domains).
BETTER_AUTH_URL=
# Optional: share the session cookie across subdomains (e.g. ".appload.co.mz").
# Leave unset on preview deployments — a mismatched domain breaks sign-in.
#COOKIE_DOMAIN=

# --- Google OAuth (staff sign-in) -------------------------------------------
# Redirect URI to register: https://<BETTER_AUTH_URL2>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- EdgeStore (file storage) ------------------------------------------------
EDGE_STORE_ACCESS_KEY=
EDGE_STORE_SECRET_KEY=
# Both used by the KYC file proxy's URL validator. PROJECT_ID unset weakens
# the check to host-only; PUBLIC_HOST defaults to files.edgestore.dev.
EDGE_STORE_PROJECT_ID=
EDGE_STORE_PUBLIC_HOST=

# --- Email (Resend) ----------------------------------------------------------
# Unset in development = emails are simulated (logged, reported ok).
# In production a missing key FAILS sends loudly — auth emails depend on it.
RESEND_API_KEY=
EMAIL_FROM=

# --- WhatsApp / SMS (Infobip) ------------------------------------------------
# Unset in development = sends are simulated. In production missing config
# fails sends loudly. The webhook secret must match the value configured in
# the Infobip portal — the inbound webhook rejects everything while unset.
INFOBIP_BASE_URL=
INFOBIP_API_KEY=
INFOBIP_SENDER=
#INFOBIP_SMS_SENDER=
INFOBIP_TRACKING_TEMPLATE=
INFOBIP_TRACKING_TEMPLATE_LANGUAGE=
INFOBIP_WEBHOOK_SECRET=

# --- Google Sheets sync (service account) -----------------------------------
GOOGLE_SHEETS_ORDERS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Keep the \n escapes — the code unescapes them
GOOGLE_PRIVATE_KEY=
# "service-account" = Sheets writes use the shared service account (current
# mode while the OAuth spreadsheets scope is pending Google verification)
NEXT_PUBLIC_GOOGLE_SHEETS_AUTH_MODE=

# --- Google Maps -------------------------------------------------------------
GOOGLE_MAPS_API_KEY=

# --- Cron (Upstash QStash) ---------------------------------------------------
# Signing keys from the Upstash console — without BOTH, every QStash
# delivery is rejected and no cron runs. Register schedules once with:
#   node apps/admin/scripts/qstash-schedules.mjs --apply
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
# Only needed by the operator running the schedules script, not the app
QSTASH_TOKEN=
# Manual/emergency cron trigger: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# --- App ---------------------------------------------------------------------
# Public origin used in emailed links (invitations) and by the QStash script
NEXT_PUBLIC_APP_URL=
# "warn" (default) logs KYC violations without blocking; "block" enforces
KYC_ENFORCEMENT=
